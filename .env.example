# NetSentinel LA-IDRS — Environment Configuration
# Copy this to .env and edit before running.

# ── Network ────────────────────────────────────────────────────────────────
# Network interface to monitor (use `ip link` to find yours)
NS_IFACE=eth0

# UNIX socket path between C packet engine and Python detection engine
NS_SOCKET=/tmp/netsentinel.sock

# ── Baseline Learning ──────────────────────────────────────────────────────
# Duration of passive observation phase in seconds (default: 86400 = 24h)
NS_BASELINE_SEC=86400

# EMA smoothing factor (0 < alpha < 1, smaller = slower adaptation)
NS_EMA_ALPHA=0.05

# Set to true to skip baseline phase entirely (useful for testing)
NS_SKIP_BASELINE=false

# ── API Server ─────────────────────────────────────────────────────────────
NS_API_HOST=0.0.0.0
NS_API_PORT=8000

# ── Logging ────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
NS_LOG_LEVEL=INFO

# ── Response Engine ────────────────────────────────────────────────────────
# How long (seconds) a blocked IP stays banned before auto-unblock (default: 1h)
NS_BAN_TTL_SEC=3600

# ── Honeypot Layer ─────────────────────────────────────────────────────────
# Number of fake listener ports to open when a scan is detected
NS_HP_PORTS=5

# ── P2P Threat Intelligence ────────────────────────────────────────────────
# Disabled by default — enable only on networks you control
NS_P2P=false
NS_P2P_PORT=9999

# Comma-separated list of peer node IPs (no spaces)
# NS_P2P_PEERS=192.168.1.10,192.168.1.11

# ── Data directories ───────────────────────────────────────────────────────
NS_DATA_DIR=data
